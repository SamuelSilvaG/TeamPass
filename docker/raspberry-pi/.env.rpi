# ============================================
# TeamPass - Variáveis de Ambiente
# Raspberry Pi 4 - Versão 3.1.7.6
# ============================================
# Copie este arquivo para .env e ajuste os valores
# NÃO commite o arquivo .env no repositório!

# ----------------------------------------
# Versões (altere aqui para atualizar)
# ----------------------------------------
TEAMPASS_VERSION=3.1.7.6
MARIADB_VERSION=11.2

# ----------------------------------------
# Rede
# ----------------------------------------
# Porta em que o TeamPass ficará acessível na rede local
TEAMPASS_PORT=8080

# URL pública do seu TeamPass (use o IP do Raspberry Pi)
# Exemplo: http://192.168.1.100:8080
TEAMPASS_URL=http://192.168.1.100:8080

# ----------------------------------------
# Banco de Dados
# ----------------------------------------
DB_NAME=teampass
DB_USER=teampass
DB_PREFIX=teampass_

# IMPORTANTE: Troque estas senhas por senhas seguras!
DB_PASSWORD=TroquePorSenhaSegura123!
MARIADB_ROOT_PASSWORD=TroquePorSenhaRootSegura456!

# ----------------------------------------
# Modo de Instalação
# ----------------------------------------
# manual = instale pelo navegador em /install/install.php (recomendado para primeira vez)
# auto   = instalação automática (requer ADMIN_PWD preenchido)
INSTALL_MODE=manual

# ----------------------------------------
# Parâmetros de Instalação Automática
# (Somente se INSTALL_MODE=auto)
# ----------------------------------------
ADMIN_EMAIL=admin@teampass.local
ADMIN_PWD=TroquePorSenhaAdmin789!

# ----------------------------------------
# PHP (ajustado para Pi 4 com 4GB RAM)
# ----------------------------------------
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_POST_MAX_SIZE=50M
PHP_MAX_EXECUTION_TIME=120
